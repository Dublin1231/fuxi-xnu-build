+    // The board producer must hold a retained device reference and quiesce its
+    // worker before stop/free. Reports are already normalized by fuxi_st.c.
+    // Never share this service with the sheng seqlock producer.
+    static IOReturn fuxiAction(OSObject *owner,void *bytes,void *amount,void *,void *) {
+        NativeHidInput *self=OSDynamicCast(NativeHidInput,owner);
+        size_t count=reinterpret_cast<uintptr_t>(amount);
+        const uint8_t *reports=static_cast<const uint8_t *>(bytes);
+        if(!self || !self->fuxiRaw || !self->fuxiReady || !reports || count<1 || count>32)
+            return kIOReturnBadArgument;
+        if(!fuxi_hid_reports_valid(reports,count*FUXI_ST_REPORT_BYTES,count))return kIOReturnBadArgument;
+        if(!self->hasEventDriverCached())return kIOReturnNotReady;
+        IOBufferMemoryDescriptor *buffers[32]={};
+        IOReturn result=kIOReturnSuccess;
+        for(size_t i=0;i<count;++i) {
+            const uint8_t *r=reports+62*i;
+            if(r[0]!=3 || r[61]>10){result=kIOReturnBadArgument;break;}
+            buffers[i]=IOBufferMemoryDescriptor::withBytes(r,62,kIODirectionNone);
+            if(!buffers[i]){result=kIOReturnNoMemory;break;}
+        }
+        if(result==kIOReturnSuccess)for(size_t i=0;i<count;++i) {
+            result=self->handleReport(buffers[i],0,0);
+            if(result!=kIOReturnSuccess)break; // producer quarantines partial delivery
+        }
+        for(size_t i=0;i<count;++i)OSSafeReleaseNULL(buffers[i]);
+        return result;
+    }
+    static IOReturn fuxiReadyAction(OSObject *owner,void *ready,void *,void *,void *) {
+        NativeHidInput *self=OSDynamicCast(NativeHidInput,owner);
+        if(!self || !self->fuxiRaw)return kIOReturnBadArgument;
+        self->fuxiReady=ready!=nullptr;return kIOReturnSuccess;
+    }
 public:
+    void setFuxiTouchOnly() {touchOnly=true;fuxiRaw=true;}
+    int sendFuxiReports(const uint8_t *bytes,size_t count) {
+        if(!inputLoop)return -1;
+        return inputLoop->runAction(&NativeHidInput::fuxiAction,this,
+            const_cast<uint8_t *>(bytes),reinterpret_cast<void *>(uintptr_t(count)))==kIOReturnSuccess?0:-1;
+    }
     void setTouchOnly() {touchOnly=true;}
