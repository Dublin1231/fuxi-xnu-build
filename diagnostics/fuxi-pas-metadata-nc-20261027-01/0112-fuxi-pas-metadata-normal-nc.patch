+/* One-variable PAS metadata mapping control. Reserved metadata RAM uses
+ * Normal NC; MMIO and every other existing mapping keep their prior policy.
+ * This does not establish or modify EL2/XPU/SHM ownership. */
+#define FG_PAS_META_PA 0x9ff600000ULL
+#define FG_PAS_META_BYTES 0x2000u
+static unsigned fg_map_cache_for_pa(uint64_t pa)
+{
+ return pa >= FG_PAS_META_PA && pa-FG_PAS_META_PA < FG_PAS_META_BYTES
+     ? VM_WIMG_WCOMB : VM_WIMG_IO;
+}
